# Copy to .env and fill in. Never commit .env.
APP_ENV=development                 # development | production
SECRET_KEY=                         # 32+ random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=                         # 32+ random chars, different from SECRET_KEY
DATABASE_URL=postgresql://localhost/resumeiq

# AI (optional - the app falls back to deterministic analysis without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_REQUEST_LIMIT=60
AI_DAILY_TOKEN_LIMIT=400000
AI_TIMEOUT_SECONDS=60

# Jobs (Remotive + Arbeitnow need no keys; Adzuna adds search + salary data)
JOB_PROVIDERS=remotive,arbeitnow,adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
JOB_CACHE_HOURS=6

# Security / networking
COOKIE_SECURE=true                  # set false only for plain-http local development
CORS_ORIGINS=                       # comma-separated, only if a separate frontend origin calls the API
TRUST_PROXY=false                   # true behind a reverse proxy / load balancer
RATELIMIT_STORAGE_URI=memory://     # use redis://... when running several instances

# Storage
STORAGE_DIR=                        # defaults to ./instance/uploads (outside any static dir)

# Email for password reset (optional; without SMTP the dev server logs the link)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
APP_BASE_URL=http://localhost:5000

LOG_LEVEL=INFO
LOG_JSON=true
